import edu.wpi.first.wpilibj2.command.Command;
import edu.wpi.first.wpilibj2.command.SubsystemBase;

public class SimplerCandleSubsystem extends SubsystemBase {
  public SimplerCandleSubsystem() {}

public void setCandleColor(double brightness, Color color) {
    candle.setControl(new SolidColor(0, 26).withColor(new RGBWColor(color).scaleBrightness(brightness)));
    }
}